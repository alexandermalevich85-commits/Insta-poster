# Text generation
TEXT_PROVIDER=gemini        # claude | gemini | openai
TEXT_MODEL=                 # empty = use provider default

# API Keys
CLAUDE_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...

# Instagram Graph API
IG_ACCESS_TOKEN=...
IG_USER_ID=...
IG_PUBLISH_METHOD=graph_api_scheduled   # graph_api | graph_api_scheduled | instagrapi

# Instagram instagrapi (fallback)
INSTAGRAPI_USERNAME=
INSTAGRAPI_PASSWORD=

# Image hosting (for Graph API — images must be public URLs)
IMGBB_API_KEY=...

# Schedule
POSTS_PER_DAY=20
PUBLISH_START_HOUR=8
PUBLISH_END_HOUR=22
TIMEZONE=Europe/Moscow

# GitHub (for syncing from Streamlit UI)
GITHUB_TOKEN=ghp_...
